{
  "name": "ai-game-development-pipeline",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-driven AI game development lab and production pipeline by By JTT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "validate": "node tools/validate-repo.mjs && node tools/validate-registry-shards.mjs && node tools/validate-reuse-registry.mjs && node tools/check-reuse-registry-freshness.mjs && node tools/validate-github-config.mjs && npm run test:reuse && npm run test:governor && npm run test:control-plane-freshness && npm run test:pipeline-run-scaffold && npm run test:run-pipeline && npm run test:studio-server",
    "validate:registry": "node tools/validate-registry-shards.mjs && node tools/validate-reuse-registry.mjs",
    "validate:reuse": "node tools/validate-reuse-registry.mjs",
    "gate:reuse-freshness": "node tools/check-reuse-registry-freshness.mjs",
    "export:reuse-public": "node tools/export-public-reuse-registry.mjs",
    "validate:record": "node tools/validate-record.mjs",
    "validate:github-config": "node tools/validate-github-config.mjs",
    "new:record": "node tools/new-record.mjs",
    "gate:graduation": "node tools/check-graduation-gate.mjs",
    "gate:lifecycle": "node tools/check-lifecycle-status.mjs",
    "gate:control-plane-freshness": "node tools/check-control-plane-freshness.mjs",
    "test:control-plane-freshness": "node tools/test-control-plane-freshness.mjs",
    "test:pipeline-run-scaffold": "node --test tools/test-pipeline-run-scaffold.mjs",
    "test:run-pipeline": "node --test tools/test-run-pipeline.mjs",
    "test:studio-server": "node --test tools/test-studio-server.mjs",
    "studio": "node tools/studio-server.mjs",
    "test:reuse": "node --test tools/test-reuse-registry.mjs tools/test-public-reuse-export.mjs",
    "test:governor": "node --test tools/test-lifecycle-status.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  }
}
