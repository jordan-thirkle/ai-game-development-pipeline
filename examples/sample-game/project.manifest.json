{
  "manifestVersion": "1.0.0",
  "projectId": "sample-game",
  "name": "Pipeline Sample Game",
  "objective": "Prove a dependency-free build, QA, release-candidate, and publishing dry run.",
  "targetPlatforms": ["web"],
  "starter": {
    "mechanic": "collect",
    "requestedTargetPlatform": "web",
    "executedTargetPlatform": "web",
    "targetExecutionStatus": "executed-local-web"
  },
  "registry": {
    "entryIds": ["system.gdevelop"]
  },
  "build": {
    "argv": ["node", "build.mjs"],
    "artifact": "dist"
  },
  "qa": {
    "argv": ["node", "qa.mjs", "{artifact}"]
  },
  "publish": {
    "provider": "local",
    "destination": "local://planned/sample-game"
  }
}
