{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://byjtt.com/schemas/execution-evidence.schema.json",
  "title":"Execution Evidence",
  "type":"object",
  "required":["schemaVersion","gateId","status","testedRevision","environment","capturedAt","checks"],
  "properties":{
    "schemaVersion":{"type":"string"},
    "gateId":{"type":"string","minLength":1},
    "status":{"enum":["pass","fail"]},
    "testedRevision":{"type":"string","minLength":7},
    "environment":{"type":"string","minLength":1},
    "capturedAt":{"type":"string","format":"date-time"},
    "checks":{"type":"array","minItems":1,"items":{"type":"object","required":["name","status"],"properties":{"name":{"type":"string"},"status":{"enum":["pass","fail"]},"evidence":{"type":"array","items":{"type":"string"}}},"additionalProperties":false}},
    "artifacts":{"type":"array","items":{"type":"string"}},
    "notes":{"type":"string"}
  },
  "additionalProperties":false
}
