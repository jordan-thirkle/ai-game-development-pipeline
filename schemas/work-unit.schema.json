{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://byjtt.com/schemas/work-unit.schema.json",
  "title":"Pipeline Work Unit",
  "type":"object",
  "$defs":{"claim":{"type":"object","properties":{"owner":{"type":"string"},"role":{"type":"string"},"claimedAt":{"type":"string","format":"date-time"},"expiresAt":{"type":"string","format":"date-time"},"leaseId":{"type":"string"}},"required":["owner","claimedAt","expiresAt","leaseId"],"additionalProperties":false}},
  "required":["schemaVersion","id","projectId","title","objective","role","status","acceptanceCriteria","evidenceRequirements"],
  "properties":{
    "schemaVersion":{"type":"string"},"id":{"type":"string","minLength":1},"projectId":{"type":"string","minLength":1},
    "stageId":{"type":["string","null"]},"title":{"type":"string","minLength":1},"objective":{"type":"string","minLength":1},"role":{"type":"string","minLength":1},
    "status":{"enum":["queued","claimed","running","blocked","verification","complete","failed","cancelled"]},"priority":{"enum":["low","normal","high","critical"]},
    "dependsOn":{"type":"array","items":{"type":"string"},"uniqueItems":true},"startRevision":{"type":["string","null"]},"resultRevision":{"type":["string","null"]},
    "claim":{"anyOf":[{"$ref":"#/$defs/claim"},{"type":"null"}]},"lastClaim":{"anyOf":[{"$ref":"#/$defs/claim"},{"type":"null"}]},
    "contextPointers":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "acceptanceCriteria":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},"evidenceRequirements":{"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "evidenceIds":{"type":"array","items":{"type":"string"},"uniqueItems":true},"approvalClass":{"enum":["autonomous","human-taste","human-spend","human-legal","human-irreversible"]},
    "retryPolicy":{"type":"object","properties":{"mode":{"enum":["none","safe-idempotent","bounded-recovery"]},"maxAttempts":{"type":"integer","minimum":0}},"required":["mode","maxAttempts"],"additionalProperties":false}
  },
  "additionalProperties":true
}
