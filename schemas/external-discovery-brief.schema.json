{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://byjtt.com/schemas/external-discovery-brief.schema.json",
  "title": "By JTT bounded external discovery brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "title", "platforms", "max_results_per_query", "capabilities"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "brief_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]+$"},
    "title": {"type": "string", "minLength": 3},
    "platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
    "max_results_per_query": {"type": "integer", "minimum": 1, "maximum": 25},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/capability"}
    }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "query", "require_signals", "required_any", "secondary_any", "canonical_seed_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
        "query": {"type": "string", "minLength": 2, "maxLength": 160},
        "require_signals": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_any": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "secondary_any": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "canonical_seed_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"}}
      }
    }
  }
}
